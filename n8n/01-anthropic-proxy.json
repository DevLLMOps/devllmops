{
  "name": "DevLLMOps 01 - Anthropic Proxy",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "devllmops-anthropic-proxy",
        "responseMode": "lastNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300],
      "id": "wf01p-01",
      "name": "Anthropic Proxy Webhook",
      "webhookId": "devllmops-anthropic-proxy",
      "notes": "Receives Anthropic API request body as JSON POST. Forwards to api.anthropic.com with authentication."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 300000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "id": "wf01p-02",
      "name": "Forward to Anthropic",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Anthropic API Key"
        }
      },
      "notes": "Forwards the request body to Anthropic Messages API. 5-minute timeout for long agent responses. Uses httpHeaderAuth for x-api-key.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Anthropic Proxy Webhook": {
      "main": [
        [
          {
            "node": "Forward to Anthropic",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null
}

      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/{{ $('Build Review Comment').item.json.repo }}/pulls/{{ $('Build Review Comment').item.json.pr_number }}/reviews",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }

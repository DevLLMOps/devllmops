# Example secrets for devllmops-jobs namespace.
# Do NOT commit real values. Use kubectl create secret instead:
#
#   kubectl create secret generic anthropic-api-key \
#     -n devllmops-jobs --from-literal=key=sk-ant-...
#
#   kubectl create secret generic github-credentials \
#     -n devllmops-jobs --from-literal=token=ghp_...
---
apiVersion: v1
kind: Secret
metadata:
  name: anthropic-api-key
  namespace: devllmops-jobs
  labels:
    app.kubernetes.io/part-of: devllmops
type: Opaque
stringData:
  key: "REPLACE_ME"
---
apiVersion: v1
kind: Secret
metadata:
  name: github-credentials
  namespace: devllmops-jobs
  labels:
    app.kubernetes.io/part-of: devllmops
type: Opaque
stringData:
  token: "REPLACE_ME"
